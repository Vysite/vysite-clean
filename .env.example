# VYSITE Environment Configuration
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the correct values for each environment.
# NEVER commit .env files with real keys to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Each environment should have its own Supabase project for data isolation.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Environment ───────────────────────────────────────────────────────────────
# Values: development | staging | production
VITE_APP_ENV=development

# ── App URL ───────────────────────────────────────────────────────────────────
# The public URL for this environment (used in links, emails, etc.)
# development: http://localhost:5173 or https://dev.vysite.com
# staging:     https://staging.vysite.com
# production:  https://app.vysite.com
VITE_APP_URL=http://localhost:5173

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to 'true' to enable. Leave blank or 'false' to disable.
# AI features require Anthropic API key set as a Supabase Edge Function secret.
VITE_ENABLE_AI=true

# ── App Version ───────────────────────────────────────────────────────────────
# Bump this on each production release for cache-busting and audit trails.
VITE_APP_VERSION=1.0.0
